generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DEVOTEE
  ADMIN
  PRIEST
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMode {
  ONLINE
  CASH
  CHECK
  CARD
  UPI
  OTHER
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  gotram             String?
  nakshatra          String?
  role               Role      @default(DEVOTEE)
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  donations     Donation[]
  eventRsvps    EventRsvp[]
  familyMembers FamilyMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FamilyMember {
  id        String  @id @default(cuid())
  userId    String
  name      String
  relation  String
  nakshatra String?
  gotram    String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  shortDesc   String?
  description String    @default("")
  price       Float
  duration    String?
  image       String?
  category    String?
  active      Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model Booking {
  id              String        @id @default(cuid())
  userId          String?
  serviceId       String
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  date            DateTime
  occasion        String?
  notes           String?
  gotra           String?
  nakshatra       String?
  sankalpam       String?
  status          BookingStatus @default(PENDING)
  paymentMode     PaymentMode   @default(ONLINE)
  isAdminEntry    Boolean       @default(false)
  receiptNumber   String?       @unique
  stripePaymentId String?
  paymentGateway  String?
  paypalOrderId   String?
  squareOrderId   String?
  guestToken      String?  @unique
  amount          Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User?   @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
}

model Donation {
  id              String         @id @default(cuid())
  userId          String?
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  address         String?
  amount          Float
  cause           String
  message         String?
  recurring       Boolean        @default(false)
  paymentMode     PaymentMode    @default(ONLINE)
  isAdminEntry    Boolean        @default(false)
  receiptNumber   String?        @unique
  checkRef        String?
  stripePaymentId String?
  paymentGateway  String?
  paypalOrderId   String?
  squareOrderId   String?
  guestToken      String?        @unique
  receiptUrl      String?
  status          DonationStatus @default(PENDING)
  createdAt       DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id])
  event   Event?  @relation(fields: [eventId], references: [id])
  eventId String?
}

model Event {
  id              String                @id @default(cuid())
  title           String
  description     String?
  date            DateTime
  endDate         DateTime?
  location        String?
  image           String?
  flyerImage      String?
  featured        Boolean               @default(false)
  createdAt       DateTime              @default(now())
  rsvps           EventRsvp[]
  donations       Donation[]
  donationOptions EventDonationOption[]
}

model EventRsvp {
  id            String   @id @default(cuid())
  userId        String?
  eventId       String
  guestName     String?
  guestEmail    String?
  guestPhone    String?
  guestToken    String?  @unique
  familyMembers Json?
  createdAt     DateTime @default(now())

  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model EventDonationOption {
  id          String  @id @default(cuid())
  eventId     String
  name        String
  description String?
  amount      Float
  recurring   Boolean @default(false)
  order       Int     @default(0)
  active      Boolean @default(true)
  highlighted Boolean @default(false)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String   @default("INFO")
  active    Boolean  @default(true)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Counter {
  id  String @id
  seq Int    @default(0)
}

model SponsorTier {
  id          String  @id @default(cuid())
  name        String
  minAmount   Float
  maxAmount   Float?
  description String?
  benefits    String?
  active      Boolean @default(true)
  highlighted Boolean @default(false)
}

model BoardMember {
  id        String   @id @default(cuid())
  name      String
  title     String
  image     String?
  bio       String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Banner {
  id          String   @id @default(cuid())
  image       String
  title       String?
  subtitle    String?
  description String?
  ctaText     String?
  ctaLink     String?
  cta2Text    String?
  cta2Link    String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model DonationTier {
  id          String  @id @default(cuid())
  name        String
  description String?
  amount      Float
  maxAmount   Float?
  recurring   Boolean @default(false)
  order       Int     @default(0)
  active      Boolean @default(true)
  highlighted Boolean @default(false)
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String?
  avatar    String?
  text      String
  rating    Int      @default(5)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model GalleryVideo {
  id        String   @id @default(cuid())
  url       String
  title     String?
  thumbnail String?
  category  String?
  createdAt DateTime @default(now())
}

model Calendar {
  id          String   @id @default(cuid())
  year        Int      @unique
  title       String?
  images      String[]
  downloadUrl String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Panchangam {
  id          String   @id @default(cuid())
  date        DateTime @unique

  samvatsara  String?
  masam       String?
  ayanam      String?
  ruthuvu     String?

  thithi      String?
  nakshatra   String?
  varjyam     String?
  durmuhurtam String?
  rahuKalam   String?
  yamagandam  String?
  goodTime    String?

  priestName  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id                  String   @id @default("main")
  // Stripe (values encrypted)
  stripeEnabled       Boolean  @default(false)
  stripePubKey        String?
  stripeSecretKey     String?
  stripeWebhookSecret String?
  // PayPal (values encrypted)
  paypalEnabled       Boolean  @default(false)
  paypalClientId      String?
  paypalSecret        String?
  paypalMode          String   @default("sandbox")
  // Square (values encrypted)
  squareEnabled       Boolean  @default(false)
  squareAccessToken   String?
  squareAppId         String?
  squareLocationId    String?
  squareMode          String   @default("sandbox")
  // Email sending — active provider + per-provider credentials (values encrypted)
  emailProvider       String   @default("gmail") // "gmail" | "hostinger"
  gmailEnabled        Boolean  @default(false)
  gmailUser           String?
  gmailAppPassword    String?
  hostingerEnabled    Boolean  @default(false)
  hostingerHost       String?  @default("smtp.hostinger.com")
  hostingerPort       Int      @default(465)
  hostingerSecure     Boolean  @default(true)
  hostingerUser       String?
  hostingerPassword   String?
  adminEmails         String?  // comma-separated, plain text
  // Contact info (public-facing; plain text, falls back to defaults in src/lib/constants.ts when unset)
  contactAddress        String?
  contactMailingAddress String?
  contactPhones         String[] @default([])
  contactEmails         String[] @default([])
  contactHours          String?
  // Social media links (public-facing; icon is hidden on the site when unset)
  facebookUrl           String?
  instagramUrl          String?
  youtubeUrl            String?
  twitterUrl            String?
  whatsappNumber        String?

  updatedAt           DateTime @updatedAt
}
