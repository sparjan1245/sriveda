# ============================================================
# Sri Veda Gayatri Temple — Environment Variables
# Copy this file to .env.local and fill in the values.
# Run `npm run generate:secrets` to auto-generate NEXTAUTH_SECRET
# and ENCRYPTION_KEY.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Supabase: Project → Settings → Database → Connection String
# Use the Session Mode pooler URL (port 5432), not the direct URL.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ── NextAuth ─────────────────────────────────────────────────
# Generate: openssl rand -base64 32   or   npm run generate:secrets
NEXTAUTH_SECRET="replace-with-generated-secret"
# Set to your production domain in production; localhost:4000 for dev:
NEXTAUTH_URL="http://localhost:4000"

# ── Encryption ───────────────────────────────────────────────
# 64 hex chars (32 bytes) — used to encrypt payment credentials stored in DB.
# Generate: openssl rand -hex 32   or   npm run generate:secrets
# WARNING: Set this ONCE before seeding. Changing it after data is written
# will break decryption of all saved gateway credentials.
ENCRYPTION_KEY="replace-with-64-hex-char-key"

# ── Public App URL ───────────────────────────────────────────
# Used in email receipt links, Square/PayPal redirect URLs, and success pages.
NEXT_PUBLIC_APP_URL="http://localhost:4000"

# ── Cloudinary (image uploads) ───────────────────────────────
# dashboard.cloudinary.com → API Keys
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Google OAuth (optional) ──────────────────────────────────
# console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Add redirect URI: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Stripe (env fallback only) ───────────────────────────────
# Preferred path: configure Stripe via Admin → Settings → Stripe tab in the UI.
# These env vars are used ONLY if no keys are saved in the database yet.
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Required for Stripe webhook signature verification (always needed as env var):
STRIPE_WEBHOOK_SECRET="whsec_..."
